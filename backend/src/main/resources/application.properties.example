# ============================================
# Smart Campus Operations Hub - Backend Configuration Template
# ============================================

# Server Port
server.port=8081

# Application Name
spring.application.name=smart-campus

# Database Configuration
# Defaults to H2 for local development. Override with MySQL values if desired.
spring.datasource.url=//localhost:3306/smart_campus_db
spring.datasource.username=root
spring.datasource.password=1234
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver 
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=${SPRING_JPA_DIALECT:org.hibernate.dialect.H2Dialect}

spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# Google Sign-In verification
# Use the same Google OAuth client ID here and in the frontend VITE_GOOGLE_CLIENT_ID.
# The current app uses Google Identity Services on the client and verifies the ID token on the backend.
spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID
spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
spring.security.oauth2.client.registration.google.scope=email,profile

# Ticket attachment storage
app.upload.ticket-images-dir=backend/uploads/tickets

# JWT
app.jwt.secret=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
app.jwt.expiration-ms=86400000
